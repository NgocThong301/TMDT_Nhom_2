# Sao chép thành .env rồi điền giá trị local của bạn.
# Không commit file .env.

COMPOSE_PROJECT_NAME=cho-sach-cu
WP_HOST_PORT=8081
WP_URL=http://localhost:8081

MYSQL_DATABASE=cho_sach_cu
MYSQL_USER=cho_sach_cu
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
WORDPRESS_TABLE_PREFIX=csc_

WP_ADMIN_USER=csc_admin
WP_ADMIN_PASSWORD=change-me-admin-password
WP_ADMIN_EMAIL=admin@cho-sach-cu.local

VENDOR1_PASSWORD=change-me-vendor-password
VENDOR2_PASSWORD=change-me-vendor-password
VENDOR3_PASSWORD=change-me-vendor-password
BUYER_PASSWORD=change-me-buyer-password

# Chỉ cần khi bật cổng VNPay (môi trường sandbox).
# Lấy tại https://sandbox.vnpayment.vn → Đăng ký merchant.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# URL trả về sau khi thanh toán, ví dụ:
#   http://localhost:8081/?wc-api=wc_vnpay_return
VNPAY_RETURN_URL=
